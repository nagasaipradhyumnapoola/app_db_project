# Supabase Project Configuration (Client-side)
# Replace these with your actual Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Configurable domain used to map Teacher ID (e.g. T001) to Auth email (e.g. t001@school.edu)
VITE_TEACHER_EMAIL_DOMAIN=school.edu

